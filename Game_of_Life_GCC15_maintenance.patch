-# Game_of_Life
\ No newline at end of file
+# Game of Life
+
+An interactive implementation of Conway's Game of Life in C, using the Linux
+MiniLibX (X11). The simulation has a 2048 × 2048 cell grid, toroidal or bounded
+edges, a movable camera, zoom and adjustable simulation speed.
+
+## Requirements
+
+Linux with an X11 server (or an XWayland-compatible desktop), a C compiler,
+GNU Make, Git and MiniLibX's X11 development dependencies.
+
+Debian / Ubuntu:
+
+```sh
+sudo apt update
+sudo apt install build-essential git libx11-dev libxext-dev libbsd-dev
+```
+
+## Build and run
+
+```sh
+make -j"$(nproc)"
+./game_of_life
+```
+
+The Makefile downloads MiniLibX and [libft](https://github.com/Matisse-Krn/libft)
+automatically. Both are pinned to revisions tested with this release, so
+rebuilding later does not silently change their source code.
+
+| Command | Effect |
+| --- | --- |
+| `make` | Build and link the program, fetching dependencies when absent |
+| `make -j4` | Build with four parallel jobs |
+| `make test` | Run headless simulation regression tests |
+| `make clean` | Remove object files and build products of local dependencies |
+| `make fclean` | Also remove the executable and libft static library |
+| `make re` | Clean and rebuild all components |
+| `make aclean` | Remove downloaded `mlx_linux/` and `libft/` directories too |
+| `make rr` | Download pinned dependencies again and fully rebuild |
+
+`aclean` and `rr` delete the locally downloaded dependency directories,
+including any changes made inside them. They do not delete the game's source
+files.
+
+## Controls
+
+| Input | Action |
+| --- | --- |
+| Space | Pause / resume |
+| N (while paused) | Advance one generation |
+| Arrow keys | Pan the camera |
+| + / - | Zoom in / out |
+| Page Up / Page Down | Increase / decrease simulation speed |
+| B | Toggle toroidal / bounded edges |
+| C | Clear all cells |
+| R | Generate a new random state |
+| Mouse drag | Move the camera |
+| Mouse wheel | Zoom |
+| Esc | Exit |
+
+## GCC 15 / C23 compatibility
+
+Starting with GCC 15, the default language mode is GNU C23. MiniLibX's
+`mlx_hook` and `mlx_loop_hook` declare callbacks as `int (*)()`, which
+means **a function taking no arguments** in C23. The application's handlers
+actually receive event data and an application pointer. With
+`-Wincompatible-pointer-types` and `-Werror`, compilation therefore fails.
+
+This project explicitly uses `-std=gnu17` when compiling its sources and
+libft. That preserves the historical meaning of MiniLibX's callback
+declarations without changing the event handlers or suppressing warnings.
+MiniLibX itself is built with its upstream Makefile.
+
+To diagnose a failed build, leave the compiler output visible and check that
+the X11 development packages listed above are installed. Compilation does
+not require a running graphical session, but launching the executable does.
+
+MiniLibX upstream: https://github.com/42paris/minilibx-linux
+
+The regression tests cover a stable block, a two-generation blinker,
+toroidal versus bounded edges, random seeding and reset operations. They use
+the simulation code directly and do not require a graphical session.
diff --git a/tests/test_world.c b/tests/test_world.c
new file mode 100644
index 0000000..d6eaed5
--- /dev/null
+++ b/tests/test_world.c
@@ -0,0 +1,130 @@
+#include "GoL.h"
+#include <assert.h>
+#include <stdio.h>
+
+static void release_world(t_world *w)
+{
+	free(w->cur);
+	free(w->next);
+}
+
+static void set_alive(t_world *w, int x, int y)
+{
+	w->cur[y * w->w + x] = 1;
+	w->population++;
+}
+
+static void assert_pattern(t_world *w, const t_point *cells, int count)
+{
+	int x;
+	int y;
+	int i;
+	int alive;
+
+	assert(w->population == (unsigned)count);
+	y = -1;
+	while (++y < w->h)
+	{
+		x = -1;
+		while (++x < w->w)
+		{
+			alive = 0;
+			i = -1;
+			while (++i < count)
+				if (cells[i].x == x && cells[i].y == y)
+					alive = 1;
+			assert(w->cur[y * w->w + x] == alive);
+		}
+	}
+}
+
+static void test_still_life(void)
+{
+	t_world w = {0};
+	const t_point block[] = {{1, 1}, {2, 1}, {1, 2}, {2, 2}};
+
+	assert(world_alloc(&w, 5, 5, BORDER_CLAMP));
+	set_alive(&w, 1, 1);
+	set_alive(&w, 2, 1);
+	set_alive(&w, 1, 2);
+	set_alive(&w, 2, 2);
+	world_step_dense(&w);
+	assert(w.gen == 1);
+	assert_pattern(&w, block, 4);
+	release_world(&w);
+}
+
+static void test_oscillator(void)
+{
+	t_world w = {0};
+	const t_point vertical[] = {{2, 1}, {2, 2}, {2, 3}};
+	const t_point horizontal[] = {{1, 2}, {2, 2}, {3, 2}};
+
+	assert(world_alloc(&w, 5, 5, BORDER_CLAMP));
+	set_alive(&w, 1, 2);
+	set_alive(&w, 2, 2);
+	set_alive(&w, 3, 2);
+	world_step_dense(&w);
+	assert(w.gen == 1);
+	assert_pattern(&w, vertical, 3);
+	world_step_dense(&w);
+	assert(w.gen == 2);
+	assert_pattern(&w, horizontal, 3);
+	release_world(&w);
+}
+
+static void test_boundary_modes(void)
+{
+	t_world w = {0};
+	const t_point wrapped[] = {{0, 1}, {0, 2}, {0, 3}};
+
+	assert(world_alloc(&w, 5, 5, BORDER_TORE));
+	set_alive(&w, 4, 2);
+	set_alive(&w, 0, 2);
+	set_alive(&w, 1, 2);
+	world_step_dense(&w);
+	assert_pattern(&w, wrapped, 3);
+	release_world(&w);
+	w = (t_world){0};
+	assert(world_alloc(&w, 5, 5, BORDER_CLAMP));
+	set_alive(&w, 4, 2);
+	set_alive(&w, 0, 2);
+	set_alive(&w, 1, 2);
+	world_step_dense(&w);
+	assert_pattern(&w, NULL, 0);
+	release_world(&w);
+}
+
+static void test_reset_and_seed(void)
+{
+	t_world w = {0};
+	int i;
+
+	assert(!world_alloc(&w, 0, 5, BORDER_CLAMP));
+	assert(world_alloc(&w, 3, 2, BORDER_CLAMP));
+	world_seed_random(&w, 100);
+	assert(w.population == 6 && w.gen == 0);
+	i = -1;
+	while (++i < 6)
+		assert(w.cur[i] == 1);
+	world_seed_random(&w, 0);
+	assert(w.population == 0);
+	i = -1;
+	while (++i < 6)
+		assert(w.cur[i] == 0);
+	world_step_dense(&w);
+	assert(w.gen == 1 && w.population == 0);
+	world_clear(&w);
+	assert(w.gen == 0 && w.population == 0);
+	release_world(&w);
+}
+
+int main(void)
+{
+	test_still_life();
+	test_oscillator();
+	test_boundary_modes();
+	test_reset_and_seed();
+	puts("World simulation tests: OK");
+	return (0);
+}
